{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/documentary-timeline/candidates.schema.json",
  "title": "Candidate passage database",
  "type": "object",
  "required": ["project", "version", "candidates"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "narrative_beat", "source_id", "speaker",
          "rough_start", "rough_end", "surrounding_context_start",
          "surrounding_context_end", "transcript", "historical_claim",
          "why_it_matters", "setup_required", "payoff", "strongest_sentence",
          "historical_confidence", "editorial_confidence", "duplication_risk",
          "weaknesses", "recommended_action"
        ],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "recommended_action": { "enum": ["Promote", "Hold", "Reject"] },
          "weaknesses": { "type": "array" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
